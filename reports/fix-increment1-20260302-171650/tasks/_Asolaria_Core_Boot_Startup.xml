    <LogonTrigger>
      <Delay>PT45S</Delay>
      <UserId>DESKTOP-J99VCNH\acer</UserId>
    </LogonTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "C:\Users\acer\Asolaria\tools\Start-Asolaria.ps1" -Port 4781 -RequireInternet -NetworkBootstrapMaxWaitSeconds 180</Arguments>
    </Exec>
  </Actions>
</Task>
