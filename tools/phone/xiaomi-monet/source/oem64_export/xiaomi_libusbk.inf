; Xiaomi Mi 10 Lite 5G - libusbK driver for scrcpy --otg
; VID 2717 / PID FF40

[Strings]
DeviceName = "Xiaomi Mi 10 Lite 5G (libusbK)"
VendorName = "Xiaomi"
SourceName = "Xiaomi libusbK Install Disk"
DeviceGUID = "{F72FE0D4-CBCB-407D-8814-9ED673D0DD6B}"

[Version]
Signature   = "$Windows NT$"
Class       = "libusbk devices"
ClassGuid   = {ECFB0CFD-74C4-4f52-BBF7-343461CD72AC}
Provider    = "libusbK"
CatalogFile = libusbK_Generic_Device.cat
DriverVer   = 06/13/2024, 3.1.0.0

; ============== Class section ==================
[ClassInstall32]
Addreg = LUsbK_Class_AddReg

[LUsbK_Class_AddReg]
HKR,,,0,"libusbK USB Devices"
HKR,,Icon,,-20

; ============== Device section =================
[Manufacturer]
%VendorName% = LUsbK_DeviceGroup,NTAMD64

[LUsbK_DeviceGroup.NTAMD64]
%DeviceName%=LUsbK_Device, USB\VID_2717&PID_FF40

[LUsbK_Device.NTAMD64]
CopyFiles = libusb_files_sys, libusb_files_dll, libusb_files_dll_syswow64

[LUsbK_Device.NTAMD64.HW]
AddReg = AddDeviceInterfaceGUID

[AddDeviceInterfaceGUID]
HKR,,DeviceInterfaceGUIDs, 0x10000,%DeviceGUID%

; ========== Driver/Service section ==============
[LUsbK_Device.NTAMD64.Services]
Addservice = libusbK, 2, LUsbK_AddService

[LUsbK_AddService]
DisplayName   = "libusbK USB Driver 06/13/2024 - 3.1.0.0"
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\libusbK.sys
AddReg        = LUsbK_Driver_AddReg

[LUsbK_Driver_AddReg]
HKR,"Parameters","DebugLevel",0x10001, 4

; =========== Sources/Destinations ==============
[SourceDisksNames]
1 = %SourceName%

[SourceDisksFiles.amd64]
libusbK.sys     = 1,amd64
libusbK.dll     = 1,amd64
libusbK_x86.dll = 1,amd64
libusb0.dll     = 1,amd64
libusb0_x86.dll = 1,amd64
WdfCoInstaller01011.dll = 1,amd64

[DestinationDirs]
DefaultDestDir          = 12
CoInstaller_CopyFiles   = 11
libusb_files_sys        = 10,system32\drivers
libusb_files_dll        = 10,system32
libusb_files_dll_syswow64 = 10,syswow64

[libusb_files_sys]
libusbK.sys

[libusb_files_dll]
libusbK.dll
libusb0.dll,,,0x00000040

[libusb_files_dll_syswow64]
libusbK.dll, libusbK_x86.dll
libusb0.dll, libusb0_x86.dll,,0x00000040

; ========= WDF/CoInstaller section =============
[LUsbK_Device.NTAMD64.CoInstallers]
AddReg=CoInstaller_AddReg
CopyFiles=CoInstaller_CopyFiles

[CoInstaller_CopyFiles]
WdfCoInstaller01011.dll

[CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000, "WdfCoInstaller01011.dll,WdfCoInstaller"

[LUsbK_Device.NTAMD64.Wdf]
KmdfService = libusbK, LUsbK_wdfsect

[LUsbK_wdfsect]
KmdfLibraryVersion=1.11

