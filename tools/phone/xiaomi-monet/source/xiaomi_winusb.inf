; Xiaomi Mi 10 Lite 5G WinUSB Driver
; For scrcpy --otg (USB HID keyboard injection)
[Version]
Signature = "$Windows NT$"
Class     = USBDevice
ClassGuid = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider  = %ManufacturerName%
DriverVer = 04/03/2026,1.0.0.0

[ClassInstall32]
AddReg = ClassInstall_AddReg

[ClassInstall_AddReg]
HKR,,,0,%ClassName%
HKR,,NoInstallClass,,1
HKR,,SilentInstall,,1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64

[Standard.NTamd64]
%DeviceName% = USB_Install, USB\VID_2717&PID_FF40

[USB_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[USB_Install.Services]
Include    = winusb.inf
AddService = WinUSB,0x00000002,WinUSB_ServiceInstall

[WinUSB_ServiceInstall]
DisplayName   = %WinUSB_SvcDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %12%\WinUSB.sys

[USB_Install.HW]
AddReg = Dev_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{F72FE0D4-CBCB-407D-8814-9ED673D0DD6B}"

[Strings]
ManufacturerName = "Asolaria"
ClassName        = "Universal Serial Bus devices"
DeviceName       = "Xiaomi Mi 10 Lite 5G (WinUSB)"
WinUSB_SvcDesc   = "WinUSB Driver"

